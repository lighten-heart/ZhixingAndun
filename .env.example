# Copy to .env. Local component scenarios work without model credentials.
GUARD_HOST=127.0.0.1
GUARD_PORT=8765
GUARD_DATA_DIR=./data
# Optional PostgreSQL connection URL; leave blank for SQLite. See README.md.
GUARD_DATABASE_URL=
# Optional immutable Docker image ID from docker image inspect. See README.md.
GUARD_SANDBOX_IMAGE=
# JSON provider -> dedicated shared receipt secret; opaque cloud accounts leave {}.
GUARD_TOKEN_RECEIPT_KEYS={}
# Optional local operator token. Enter the same token in the frontend settings.
GUARD_API_TOKEN=
GUARD_URL=http://127.0.0.1:8765
# Independent semantic judge: set harness to reuse installed Harness login.
# Omit or leave empty for deterministic component demonstrations.
GUARD_MODEL_BACKEND=
# Alternative: GUARD_MODEL_BACKEND=http and the compatible service below.
GUARD_MODEL_BASE_URL=
GUARD_MODEL_NAME=
GUARD_MODEL_KEY=
# Optional operator-maintained rates; [] means unknown cost, never zero cost.
# Each entry: provider, model, currency, as_of, input_per_million,
# output_per_million, cache_read_per_million, cache_write_per_million.
# Use actual account rates; estimates are not provider billing statements.
GUARD_MODEL_PRICING_JSON=[]
# Optional distinct API roles; keep blank for local single-operator use.
GUARD_REVIEWER_TOKEN=
GUARD_ADAPTER_TOKEN=
GUARD_VIEWER_TOKEN=
# Business agent model, only used by python -m adapters.reference_agent.
AGENT_MODEL_BASE_URL=
AGENT_MODEL_NAME=
AGENT_MODEL_KEY=
# Primary competition host: installed DeepSeek Harness (requires Node.js 22+).
# Reuses the local Harness login; never paste its credentials into this file.
HARNESS_PROVIDER=deepseek-account
HARNESS_MODEL=deepseek-flash
# Optional absolute overrides (omit/unset to use automatic discovery):
# HARNESS_DESKTOP_DIR=C:/Users/YourName/AppData/Local/Programs/DeepSeek Harness
# HARNESS_RUNTIME_DIR=C:/Users/YourName/.cache/aegisguard/harness-0.2.0-rc.2
# HARNESS_USER_HOME=C:/Users/YourName/.dsh
